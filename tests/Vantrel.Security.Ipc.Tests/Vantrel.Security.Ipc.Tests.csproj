<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest" Version="3.6.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vantrel.Security.Core\Vantrel.Security.Core.csproj" />
    <ProjectReference Include="..\..\src\Vantrel.Security.Infrastructure\Vantrel.Security.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Vantrel.Security.Service\Vantrel.Security.Service.csproj" />
    <ProjectReference Include="..\..\tools\Vantrel.Security.OfflineUpdateTool\Vantrel.Security.OfflineUpdateTool.csproj" />
    <ProjectReference Include="..\Vantrel.Security.LocalServiceAclHarness\Vantrel.Security.LocalServiceAclHarness.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Vantrel.Security.LocalServiceAclHarness\HarnessProtocol.cs"
             Link="LocalServiceAclHarness\HarnessProtocol.cs" />
    <Compile Include="..\Vantrel.Security.LocalServiceAclHarness\ProductParentNativeAccessEvidence.cs"
             Link="LocalServiceAclHarness\ProductParentNativeAccessEvidence.cs" />
  </ItemGroup>

  <!-- Prepare the reviewed, framework-dependent harness payload before VSTest runs.
       This is a fixed test project/RID/output with no restore or caller-selected command. -->
  <Target Name="PrepareLocalServiceHarnessPublish" BeforeTargets="VSTest">
    <Error Condition="'$(Configuration)' != 'Debug' and '$(Configuration)' != 'Release'"
           Text="LocalService harness publish requires Debug or Release." />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Vantrel.Security.LocalServiceAclHarness\Vantrel.Security.LocalServiceAclHarness.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0-windows;RuntimeIdentifier=win-x64;SelfContained=false;PublishSelfContained=false;PublishSingleFile=false;PublishTrimmed=false;UseAppHost=true;Restore=false;SkipCopyUnchangedFiles=false;CopyOutputSymbolsToPublishDirectory=false;PublishDir=$(MSBuildThisFileDirectory)..\Vantrel.Security.LocalServiceAclHarness\bin\$(Configuration)\net10.0-windows\win-x64\publish\" />
  </Target>

</Project>
