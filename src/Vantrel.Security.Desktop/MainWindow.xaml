<Window x:Class="Vantrel.Security.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{StaticResource ProductName}" Width="1040" Height="680" MinWidth="850" MinHeight="560"
        Background="#0B1220" Foreground="#EAF1FA" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="#C7D5E5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1C3653"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#223B58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#111D2F" BorderBrush="#263B52" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,28">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,34">
                    <TextBlock Text="{StaticResource ProductName}" FontWeight="Bold" FontSize="23"/>
                    <TextBlock Text="{StaticResource ProductTagline}" Foreground="#70D5CB" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="PRE-RELEASE  ·  FOUNDATION" Foreground="#8397AC" FontSize="10" Margin="12,18"/>
                <ListBox x:Name="SectionList" Background="Transparent" BorderThickness="0" SelectedIndex="0" SelectionChanged="NavigationChanged">
                    <ListBoxItem Content="Dashboard"/>
                    <ListBoxItem Content="Scan"/>
                    <ListBoxItem Content="File inspection"/>
                    <ListBoxItem Content="Installation"/>
                    <ListBoxItem Content="Protection"/>
                    <ListBoxItem Content="Network"/>
                    <ListBoxItem Content="System Health"/>
                    <ListBoxItem Content="Quarantine"/>
                    <ListBoxItem Content="Activity"/>
                    <ListBoxItem Content="Settings"/>
                </ListBox>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="42,34,42,34">
                <TextBlock Text="{StaticResource ProductName}" Foreground="#70D5CB" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="SectionTitle" Text="Dashboard" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,6"/>
                <TextBlock Text="System overview" Foreground="#9AAEC2" FontSize="14" Margin="0,0,0,28"/>
                <StackPanel x:Name="DashboardPanel">
                    <Border Background="#152438" CornerRadius="14" Padding="26" BorderBrush="#29415B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="PROTECTION STATUS" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="ProtectionStatusText" Text="Unavailable" FontSize="27" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <TextBlock Text="Protection features are not implemented in this development build." Foreground="#A8B9C9" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#152438" CornerRadius="14" Padding="24" BorderBrush="#29415B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="SERVICE STATUS" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                                <TextBlock x:Name="ServiceStatusText" Text="Disconnected" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                <TextBlock x:Name="ServiceVersionText" Text="Service version: —" Foreground="#A8B9C9" Margin="0,0,0,4"/>
                                <TextBlock x:Name="HeartbeatText" Text="Checking local service…" Foreground="#A8B9C9" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ServiceDiagnosticText" Foreground="#D5B77E" FontSize="11"
                                           Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#152438" CornerRadius="14" Padding="24" BorderBrush="#29415B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DESKTOP VERSION" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                                <TextBlock x:Name="VersionText" Text="Loading..." FontSize="22" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                <TextBlock Text="Pre-release development build" Foreground="#A8B9C9"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
                <Border x:Name="ScanPanel" Visibility="Collapsed" Background="#152438" CornerRadius="14"
                        Padding="26" BorderBrush="#29415B" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="SCAN CAPABILITY" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="ScanStateText" Text="Loading - checking service" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,12,0,10" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ScanSampleText" Text="Sample: unavailable" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ScanPolicyText" Text="Policy revision: unavailable" Margin="0,0,0,18"/>
                        <TextBlock x:Name="ScanCapabilityText" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Text="Vantrel does not yet perform file scanning. It accepts no client-supplied scan target and has no scheduled targets. Detection, quarantine, remediation, and real-time protection are not available."
                                   Foreground="#A8B9C9" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border x:Name="InstallationPanel" Visibility="Collapsed" Background="#152438" CornerRadius="14"
                        Padding="26" BorderBrush="#29415B" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="INSTALLATION STATUS" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <Separator Margin="0,20,0,16"/>
                        <TextBlock Text="VANTREL COMPONENT INSPECTION" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="InspectionStateText" Text="Loading - checking service" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,8" TextWrapping="Wrap"/>
                        <TextBlock x:Name="InspectionSampleText" Text="Sample: unavailable" Margin="0,0,0,8"/>
                        <TextBlock x:Name="InspectionValueText" Text="Observation: unavailable" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="This is an observed Vantrel component hash only. No trusted reference hash or detection policy is applied."
                                   Foreground="#A8B9C9" TextWrapping="Wrap"/>
                        <Separator Margin="0,20,0,16"/>
                        <TextBlock Text="VANTREL COMPONENT INTEGRITY" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="IntegrityStateText" Text="Loading - checking service" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,8" TextWrapping="Wrap"/>
                        <TextBlock x:Name="IntegritySampleText" Text="Sample: unavailable" Margin="0,0,0,8"/>
                        <TextBlock x:Name="IntegrityValueText" Text="Integrity: unavailable" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="This compares only the fixed Vantrel Core component with the build-pinned reference compiled into this Service build. It is not a malware or system-wide trust verdict."
                                   Foreground="#A8B9C9" TextWrapping="Wrap"/>
                        <Separator Margin="0,20,0,16"/>
                        <TextBlock Text="VANTREL SIGNED INSTALLATION INTEGRITY" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="TrustedManifestStateText" Text="Loading - checking service" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,8" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TrustedManifestSampleText" Text="Sample: unavailable" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TrustedManifestValueText" Text="Manifest authentication: unavailable" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                            <Button x:Name="RefreshIntegrityButton" Content="Refresh integrity" Click="RefreshIntegrityClicked"
                                    IsEnabled="False" Padding="14,7" Margin="0,0,12,0"/>
                            <TextBlock x:Name="RefreshIntegrityStatusText" Text="Service connection required." VerticalAlignment="Center"
                                       Foreground="#A8B9C9" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="This authenticates a fixed signed manifest and compares seven fixed installed Vantrel service files. It is not a malware, safety, or system-wide trust verdict."
                                   Foreground="#A8B9C9" TextWrapping="Wrap"/>
                        <Separator Margin="0,20,0,16"/>
                        <TextBlock Text="SIGNED RELEASE PROVENANCE" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="ReleaseProvenanceStateText" Text="Loading - checking service" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,8" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ReleaseProvenanceSampleText" Text="Sample: unavailable" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ReleaseProvenanceValueText" Text="Release metadata: unavailable" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="This verifies fixed signed release metadata bound to the current signed manifest and applies a local anti-rollback policy. It does not install, update, repair, or establish system-wide trust."
                                   Foreground="#A8B9C9" TextWrapping="Wrap"/>
                        <Separator Margin="0,20,0,16"/>
                        <TextBlock Text="UPDATE TRANSACTION" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="UpdateTransactionStateText" Text="Loading - checking service" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,8" TextWrapping="Wrap"/>
                        <TextBlock x:Name="UpdateTransactionSampleText" Text="Sample: unavailable" Margin="0,0,0,8"/>
                        <TextBlock x:Name="UpdateTransactionValueText" Text="Update transaction: unavailable." TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="This read-only view reports a guarded offline Administrator transaction. It has no package selection or update controls."
                                   Foreground="#A8B9C9" TextWrapping="Wrap"/>
                        <Separator Margin="0,20,0,16"/>
                        <TextBlock Text="INTEGRITY REFRESH ACTIVITY" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="IntegrityRefreshAuditStateText" Text="Loading - checking service" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,8" TextWrapping="Wrap"/>
                        <TextBlock x:Name="IntegrityRefreshAuditSessionText" Text="Current service session only" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="IntegrityRefreshAuditEntries" Margin="0,0,0,10"/>
                        <TextBlock Text="This memory-only list exposes at most the newest 16 authorized integrity-refresh lifecycle outcomes. It does not contain identities, request IDs, paths, hashes, or integrity truth."
                                   Foreground="#A8B9C9" TextWrapping="Wrap"/>
                        <Separator Margin="0,20,0,16"/>
                        <TextBlock Text="SIGNED INSTALLATION INTEGRITY HISTORY" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="TrustedManifestHistoryStateText" Text="Loading - checking service" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,8" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TrustedManifestHistorySessionText" Text="Current service session only" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="TrustedManifestHistoryEntries" Margin="0,0,0,10"/>
                        <TextBlock Text="This memory-only newest-first history exposes at most 12 completed signed-installation evaluations. Historical entries do not establish current integrity truth."
                                   Foreground="#A8B9C9" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border x:Name="FileInspectionPanel" Visibility="Collapsed" Background="#152438" CornerRadius="14"
                        Padding="26" BorderBrush="#29415B" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="FILE INSPECTION" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="FileInspectionNoticeText" TextWrapping="Wrap" Margin="0,10,0,14"/>
                        <Button x:Name="ChooseFileForInspectionButton" Content="Choose file" Click="ChooseFileForInspectionClicked"
                                Padding="14,7" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock x:Name="FileInspectionStateText" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel x:Name="FileInspectionResultPanel" Visibility="Collapsed">
                            <TextBlock Text="FILE NAME" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="FileInspectionNameText" TextWrapping="Wrap" Margin="0,6,0,12"/>
                            <TextBlock Text="BYTE COUNT" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="FileInspectionByteCountText" TextWrapping="Wrap" Margin="0,6,0,12"/>
                            <TextBlock Text="SHA-256 FINGERPRINT" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="FileInspectionFingerprintText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Separator Margin="0,20,0,16"/>
                        <TextBlock Text="SHA-256 COMPARISON" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="FileComparisonNoticeText" TextWrapping="Wrap" Margin="0,10,0,12"/>
                        <Label Content="Expected SHA-256 value" Target="{Binding ElementName=ExpectedSha256TextBox}" Padding="0"/>
                        <TextBox x:Name="ExpectedSha256TextBox" MaxLength="64" Width="460" HorizontalAlignment="Left"
                                 automation:AutomationProperties.Name="Expected SHA-256 value" Margin="0,4,0,12"/>
                        <Button x:Name="ChooseFileForComparisonButton" Content="Choose file and compare" Click="ChooseFileForComparisonClicked"
                                Padding="14,7" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock x:Name="FileComparisonStateText" TextWrapping="Wrap"
                                   automation:AutomationProperties.LiveSetting="Polite" Margin="0,0,0,0"/>
                        <Separator Margin="0,20,0,16"/>
                        <TextBlock Text="FOLDER FINGERPRINT INVENTORY" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="FolderInventoryNoticeText" TextWrapping="Wrap" Margin="0,10,0,14"/>
                        <Button x:Name="ChooseFolderForInventoryButton" Content="Choose folder and inventory" Click="ChooseFolderForInventoryClicked"
                                Padding="14,7" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock x:Name="FolderInventoryStateText" TextWrapping="Wrap"
                                   automation:AutomationProperties.LiveSetting="Polite" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="FolderInventoryEntries" Margin="0,0,0,0"/>
                        <Separator Margin="0,20,0,16"/>
                        <TextBlock Text="EMBEDDED AUTHENTICODE PUBLISHER INSPECTION" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="PublisherInspectionNoticeText" TextWrapping="Wrap" Margin="0,10,0,14"/>
                        <Button x:Name="ChooseFileForPublisherInspectionButton" Content="Choose file" Click="ChooseFileForPublisherInspectionClicked"
                                Padding="14,7" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock x:Name="PublisherInspectionStateText" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel x:Name="PublisherInspectionResultPanel" Visibility="Collapsed">
                            <TextBlock Text="FILE NAME" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="PublisherInspectionNameText" TextWrapping="Wrap" Margin="0,6,0,12"/>
                            <TextBlock Text="BYTE COUNT" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="PublisherInspectionByteCountText" TextWrapping="Wrap" Margin="0,6,0,12"/>
                            <TextBlock Text="DECLARED EMBEDDED SIGNER SUBJECT" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="PublisherInspectionSignerText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Separator Margin="0,20,0,16"/>
                        <TextBlock Text="WINDOWS SIGNATURE INSPECTION" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="WindowsSignatureInspectionNoticeText" TextWrapping="Wrap" Margin="0,10,0,14"/>
                        <Button x:Name="ChooseFileForWindowsSignatureInspectionButton" Content="Choose file" Click="ChooseFileForWindowsSignatureInspectionClicked"
                                Padding="14,7" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock x:Name="WindowsSignatureInspectionStateText" TextWrapping="Wrap"
                                   automation:AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
                        <StackPanel x:Name="WindowsSignatureInspectionResultPanel" Visibility="Collapsed">
                            <TextBlock Text="FILE NAME" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="WindowsSignatureInspectionNameText" TextWrapping="Wrap" Margin="0,6,0,12"/>
                            <TextBlock Text="BYTE COUNT" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="WindowsSignatureInspectionByteCountText" TextWrapping="Wrap" Margin="0,6,0,12"/>
                            <TextBlock Text="EMBEDDED AUTHENTICODE OBSERVATION" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="WindowsSignatureInspectionEmbeddedText" TextWrapping="Wrap" Margin="0,6,0,12"/>
                            <TextBlock Text="DECLARED EMBEDDED SIGNER SUBJECT" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="WindowsSignatureInspectionSignerText" TextWrapping="Wrap" Margin="0,6,0,12"/>
                            <TextBlock Text="LOCAL CATALOG OBSERVATION" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="WindowsSignatureInspectionCatalogText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="ProtectionPanel" Visibility="Collapsed" Background="#152438" CornerRadius="14"
                        Padding="26" BorderBrush="#29415B" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="PROTECTION OVERVIEW" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="ProtectionOverviewNoticeText" TextWrapping="Wrap" Margin="0,10,0,18"/>
                        <TextBlock Text="SERVICE CONNECTION AND HEARTBEAT" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="ProtectionServiceText" TextWrapping="Wrap" Margin="0,8,0,16"/>
                        <TextBlock Text="WINDOWS-REPORTED AGGREGATE ANTIVIRUS" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="ProtectionAntivirusText" TextWrapping="Wrap" Margin="0,8,0,16"/>
                        <TextBlock Text="WINDOWS-REPORTED AGGREGATE FIREWALL" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="ProtectionFirewallText" TextWrapping="Wrap" Margin="0,8,0,16"/>
                        <TextBlock Text="WINDOWS-REPORTED REGISTERED PROVIDERS" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="ProtectionProviderInventoryNoticeText" TextWrapping="Wrap" Margin="0,8,0,10"/>
                        <TextBlock x:Name="ProtectionProviderInventoryStateText" TextWrapping="Wrap"
                                   automation:AutomationProperties.LiveSetting="Polite" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="ProtectionProviderInventoryEntries" Margin="0,0,0,16"/>
                        <TextBlock Text="SIGNED INSTALLATION INTEGRITY" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="ProtectionInstallationText" TextWrapping="Wrap" Margin="0,8,0,16"/>
                        <TextBlock Text="SIGNED RELEASE PROVENANCE AND LOCAL POLICY" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="ProtectionProvenanceText" TextWrapping="Wrap" Margin="0,8,0,16"/>
                        <TextBlock Text="OFFLINE UPDATE TRANSACTION AND RECOVERY" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="ProtectionUpdateText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="NetworkPanel" Visibility="Collapsed" Background="#152438" CornerRadius="14"
                        Padding="26" BorderBrush="#29415B" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="WINDOWS FIREWALL PROFILE OBSERVATIONS" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="NetworkFirewallProfileNoticeText" TextWrapping="Wrap" Margin="0,10,0,12"/>
                        <TextBlock x:Name="NetworkFirewallProfileStateText" TextWrapping="Wrap"
                                   automation:AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="NetworkFirewallProfileEntries"/>
                    </StackPanel>
                </Border>
                <Border x:Name="SystemHealthPanel" Visibility="Collapsed" Background="#152438" CornerRadius="14"
                        Padding="26" BorderBrush="#29415B" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="SYSTEM HEALTH" Foreground="#9CB4CA" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="HealthStateText" Text="Unavailable — checking service" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,12,0,10" TextWrapping="Wrap"/>
                        <TextBlock x:Name="HealthDiagnosticText" Foreground="#D5B77E" FontSize="11"
                                   Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <TextBlock x:Name="HealthSampleText" Text="Sample: unavailable" Foreground="#A8B9C9" Margin="0,0,0,18"/>
                        <TextBlock x:Name="HealthWindowsText" Text="Windows version/build: Unavailable" Margin="0,0,0,12"/>
                        <TextBlock x:Name="HealthUptimeText" Text="Elapsed since system start: Unavailable" Margin="0,0,0,12"/>
                        <TextBlock x:Name="HealthDiskText" Text="Windows system volume: Unavailable" Margin="0,0,0,18"/>
                        <TextBlock x:Name="HealthAntivirusText" Text="Windows-reported antivirus health: Unavailable"
                                   Margin="0,0,0,18" TextWrapping="Wrap"/>
                        <TextBlock x:Name="HealthFirewallText" Text="Windows-reported firewall health: Unavailable"
                                   Margin="0,0,0,18" TextWrapping="Wrap"/>
                        <TextBlock Text="Windows reports aggregate categories. Firewall profiles and rules have not been audited. Vantrel protection remains Unavailable."
                                   Foreground="#A8B9C9" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border x:Name="ActivityPanel" Visibility="Collapsed" Background="#152438" CornerRadius="14"
                        Padding="26" BorderBrush="#29415B" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="WINDOWS-REPORTED HEALTH OBSERVATIONS" Foreground="#9CB4CA"
                                   FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="ActivityStateText" Text="Loading - checking service" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,12,0,10" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ActivitySessionText" Text="Service start: unavailable" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ActivitySampleText" Text="Sampled through: unavailable" Margin="0,0,0,18"/>
                        <ItemsControl x:Name="ActivityEntries" Margin="0,0,0,18"/>
                        <TextBlock Text="Observed at is the sample time, not the time Windows changed state. This memory-only history resets when the service restarts. These are not Vantrel detections or protection events."
                                   Foreground="#A8B9C9" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border x:Name="PlaceholderPanel" Visibility="Collapsed" Background="#152438" CornerRadius="14" Padding="26" BorderBrush="#29415B" BorderThickness="1">
                    <TextBlock x:Name="PlaceholderText" TextWrapping="Wrap" FontSize="16" Foreground="#B9CBDC"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
